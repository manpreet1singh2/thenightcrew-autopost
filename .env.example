# Mac par: is file ko copy karke ".env" naam do aur values bharo:  cp .env.example .env
# .env kabhi GitHub par commit mat karna (ye .gitignore me hai). GitHub ke liye values Secrets me jaati hain.
# Comments hamesha alag line par likho, value ke saath nahi.

# ===== Zaroori =====
# openrouter.ai/keys
OPENROUTER_API_KEY=
# Graph API Explorer (Dimple Bot App - Test1) ka long-lived user token
FB_USER_TOKEN=
# The night crew
FB_PAGE_ID=628058697050691

# ===== FreeVideo (Mac) =====
# FreeVideo install folder me "freevideo" file ka poora path
FREEVIDEO_CMD=
VIDEOS_PER_DAY=5
# M5 par 30 sec ~66 min / video (544x960)
VIDEO_SECONDS=30
# light | medium | high | max
VIDEO_QUALITY=light
LONG_TIMES=09:00,12:00,15:00,18:00,21:00
# har video ke clips (1 = kam posts, reach ke liye behtar)
CLIP_COUNT=2
# long video ke kitne minute baad clip
CLIP_GAP_MIN=60

# ===== Optional =====
# OPENROUTER_MODEL=anthropic/claude-opus-5.5
# TREND_TOPICS=0
# TREND_GEO=IN
# VIDEO_PAGES=all
